<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Ambiance" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/ink</item>
        <item name="android:colorBackground">@color/ink</item>
        <item name="android:colorAccent">@color/ember</item>
        <item name="android:statusBarColor">@color/ink</item>
        <item name="android:navigationBarColor">@color/ink</item>
    </style>

    <style name="Theme.Ambiance.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <color name="ink">#0D1524</color>
    <color name="ember">#F2A65A</color>
</resources>
